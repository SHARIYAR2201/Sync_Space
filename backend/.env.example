# REQUIRED in production (app refuses the default secret when APP_ENV=production)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Optional: defaults to local SQLite. PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/syncspace
DATABASE_URL=sqlite:///./syncspace.db
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
