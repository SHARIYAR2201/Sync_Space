# REQUIRED in production (app refuses the default secret when APP_ENV=production)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Optional: defaults to local SQLite. PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/syncspace
DATABASE_URL=sqlite:///./syncspace.db
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Email (needed for invitation and password-reset emails) ---
# Gmail example: turn on 2-Step Verification, create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=SyncSpace <your.address@gmail.com>
# Public address of the app, used in the invitation link (no trailing slash)
APP_URL=http://127.0.0.1:8000
